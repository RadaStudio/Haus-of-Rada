# Keystatic — GitHub storage mode
# Questi valori vengono generati dal flow guidato di Keystatic (crea GitHub App)
# e scritti automaticamente in un file .env locale. Copiarli anche su Vercel.
# NON committare il file .env reale (è in .gitignore).

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# In Astro il prefisso PUBLIC_ è necessario per esporre lo slug al client:
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
