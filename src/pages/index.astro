---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroRadiance from '../components/HeroRadiance.astro';
import WorldIndex from '../components/WorldIndex.astro';
import JournalCard from '../components/JournalCard.astro';
import home from '../content/pagine/home.json';
import { accentDuo } from '../lib/text';

const journalPreview = home.journalPreview;
const metodo = (home as any).metodo;
---
<BaseLayout transparentNav={true}>
  <HeroRadiance />

  <!-- MANIFESTO -->
  <section class="manifesto reveal">
    <p class="eyebrow">{home.manifestoEyebrow}</p>
    <p class="statement" set:html={accentDuo(home.manifestoStatement)}></p>
    <p class="note">{home.manifestoNota}</p>
  </section>

  <!-- METODO / IL PERCORSO -->
  {metodo && (
    <section class="metodo reveal">
      <div class="metodo-head">
        {metodo.eyebrow && <p class="eyebrow eyebrow--gold">{metodo.eyebrow}</p>}
        <h2>{metodo.titolo}</h2>
        {metodo.testo && metodo.testo.split('\n').filter(Boolean).map((par: string) => <p class="mtxt">{par}</p>)}
      </div>
      <div class="metodo-passi" id="metodo-passi">
        <div class="mp-track">
          <span class="mp-line" aria-hidden="true"></span>
          <span class="mp-fill" aria-hidden="true"></span>
          <ol>
            {(metodo.passi ?? []).map((s: any) => (
              <li>
                <span class="mp-node" aria-hidden="true"></span>
                <h3>{s.titolo}</h3>
                <p>{s.testo}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
      {metodo.linkLabel && (
        <p class="metodo-link">
          {metodo.linkTesto} <a href={metodo.linkHref || '/percorso'}>{metodo.linkLabel}</a>
        </p>
      )}
    </section>
  )}

  <!-- INDICE DEI MONDI -->
  <WorldIndex />

  <!-- PROGETTO IN EVIDENZA (banda cinematografica scura) -->
  <section
    class:list={['featured reveal', (home as any).featuredImmagine && 'has-photo']}
    style={(home as any).featuredImmagine
      ? `background-image: linear-gradient(180deg, rgba(20,26,21,.35), rgba(20,26,21,.72)), url(${(home as any).featuredImmagine}); background-size: cover; background-position: center;`
      : undefined}
  >
    <div class="featured-inner">
      <p class="eyebrow">{home.featuredEyebrow}</p>
      <h3>{home.featuredTitolo.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h3>
      <p>{home.featuredTesto}</p>
      <a class="btn" href={home.featuredHref}>{home.featuredCta}</a>
    </div>
  </section>

  <!-- PREVIEW JOURNAL -->
  <section class="journal">
    <div class="journal-head">
      <h2>{home.journalHeading}</h2>
      <a class="btn btn--dark" href="/journal">{home.journalCta}</a>
    </div>
    <div class="journal-grid">
      {journalPreview.map((j) => (
        <JournalCard
          stamp={j.stamp}
          title={j.title}
          place={j.place}
          frame={j.frame}
          image={(j as any).immagine}
          tone={j.tono as 'warm' | 'green' | 'amber' | 'stone'}
          href={j.href}
        />
      ))}
    </div>
  </section>

  <!-- CHIUSURA (CTA breve → Contatti) -->
  <section class="home-chiusura reveal">
    <h2>{(home as any).chiusuraTitolo}</h2>
    <p>{(home as any).chiusuraTesto}</p>
    <a class="btn" href="/contatti">{(home as any).chiusuraCta}</a>
  </section>
</BaseLayout>

<style>
  /* ---------- MANIFESTO ---------- */
  .manifesto { padding: clamp(90px, 15vh, 190px) var(--pad); max-width: 1200px; }
  .manifesto .eyebrow { margin-bottom: 34px; }
  .manifesto .statement {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(24px, 3.4vw, 46px);
    line-height: 1.28;
    letter-spacing: -.01em;
    max-width: 20ch;
  }
  .manifesto .hl { font-style: italic; color: var(--green); }
  .manifesto .amberhl { color: var(--amber); font-style: italic; }
  .manifesto .note {
    font-family: var(--sans);
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 52ch;
    margin-top: 38px;
    line-height: 1.7;
  }

  /* ---------- METODO ---------- */
  .metodo {
    padding: clamp(20px, 4vh, 40px) var(--pad) clamp(70px, 12vh, 130px);
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--line);
  }
  .metodo-head { max-width: 720px; padding-top: clamp(40px, 7vh, 70px); }
  .metodo-head h2 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(26px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -.02em;
    margin: .18em 0 .5em;
  }
  .metodo-head .mtxt { color: var(--ink-soft); line-height: 1.7; margin-bottom: 1em; max-width: 60ch; }
  /* linea-processo: 4 nodi collegati da una linea che si "disegna" allo scroll */
  .metodo-passi { margin: clamp(46px, 7vh, 72px) 0 clamp(30px, 4vh, 40px); }
  .mp-track { position: relative; }
  .mp-track ol { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(20px, 3vw, 40px); }
  .mp-track li { position: relative; padding-top: 34px; text-align: center; padding-inline: clamp(4px, 1.2vw, 16px); }
  .mp-node {
    position: absolute; top: 0; left: 50%;
    width: 13px; height: 13px; border-radius: 50%;
    background: var(--ivory); border: 1.5px solid var(--line);
    box-shadow: 0 0 0 5px var(--ivory);
    transform: translateX(-50%); z-index: 2;
    transition: background .45s var(--ease), border-color .45s var(--ease), transform .45s var(--ease);
  }
  .mp-line, .mp-fill { position: absolute; top: 6px; height: 1.5px; left: 12.5%; right: 12.5%; }
  .mp-line { background: var(--line); }
  .mp-fill { background: var(--amber); transform: scaleX(0); transform-origin: left center; transition: transform 1.5s var(--ease); }
  .metodo-passi.drawn .mp-fill { transform: scaleX(1); }
  .metodo-passi.drawn .mp-node { border-color: var(--amber); background: var(--amber); transform: translateX(-50%) scale(1.12); }
  .metodo-passi.drawn li:nth-child(1) .mp-node { transition-delay: .1s; }
  .metodo-passi.drawn li:nth-child(2) .mp-node { transition-delay: .5s; }
  .metodo-passi.drawn li:nth-child(3) .mp-node { transition-delay: .9s; }
  .metodo-passi.drawn li:nth-child(4) .mp-node { transition-delay: 1.3s; }
  .mp-track h3 { font-family: var(--serif); font-weight: 400; font-size: clamp(18px, 1.9vw, 23px); letter-spacing: -.01em; margin-bottom: 8px; }
  .mp-track p { color: var(--ink-soft); font-size: 14px; line-height: 1.55; margin: 0 auto; max-width: 24ch; }
  .metodo-link { color: var(--ink-soft); font-size: 15px; max-width: 60ch; }
  .metodo-link a { color: var(--amber); border-bottom: 1px solid var(--amber); padding-bottom: 1px; white-space: nowrap; }

  /* mobile: la linea diventa verticale (timeline) */
  @media (max-width: 700px) {
    .mp-track ol { grid-template-columns: 1fr; gap: 0; }
    .mp-track li { text-align: left; padding: 0 0 clamp(22px, 4vh, 34px) 30px; }
    .mp-track li:last-child { padding-bottom: 0; }
    .mp-node { top: 4px; left: 0; transform: none; }
    .metodo-passi.drawn .mp-node { transform: scale(1.12); }
    .mp-line, .mp-fill { top: 8px; bottom: 14px; left: 6px; right: auto; width: 1.5px; height: auto; }
    .mp-fill { transform: scaleY(0); transform-origin: center top; }
    .metodo-passi.drawn .mp-fill { transform: scaleY(1); }
    .mp-track p { max-width: 40ch; }
  }

  /* ---------- FEATURED ---------- */
  .featured {
    position: relative;
    margin: clamp(30px, 6vh, 80px) 0;
    min-height: 82vh;
    display: flex;
    align-items: flex-end;
    color: var(--ivory);
    overflow: hidden;
    background:
      radial-gradient(80% 120% at 20% 0%, rgba(244, 217, 160, .28), rgba(244, 217, 160, 0) 55%),
      linear-gradient(180deg, #3a4a3c 0%, #29352b 60%, #1d2620 100%);
  }
  .featured.has-photo::before { content: none; }
  .featured::before {
    content: "[ fotografia a tutto schermo: progetto in evidenza ]";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: rgba(245, 239, 226, .4);
  }
  .featured-inner { position: relative; z-index: 2; padding: var(--pad); max-width: 820px; }
  .featured .eyebrow { color: var(--glow); }
  .featured h3 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(34px, 6vw, 86px);
    line-height: 1;
    letter-spacing: -.02em;
    margin: .2em 0;
  }
  .featured p { max-width: 44ch; color: rgba(245, 239, 226, .8); }
  .featured .btn { margin-top: 26px; }

  /* ---------- JOURNAL ---------- */
  .journal { padding: clamp(80px, 13vh, 150px) var(--pad); }
  .journal-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 44px;
  }
  .journal-head h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 4vw, 52px);
    letter-spacing: -.01em;
    max-width: 16ch;
  }
  .journal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px); }

  /* ---------- CHIUSURA HOME ---------- */
  .home-chiusura {
    background: var(--green-deep);
    color: var(--ivory);
    padding: clamp(70px, 13vh, 140px) var(--pad);
    text-align: center;
  }
  .home-chiusura h2 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(32px, 6vw, 76px);
    line-height: 1;
    letter-spacing: -.02em;
    margin-bottom: .35em;
  }
  .home-chiusura p { color: rgba(245, 239, 226, .8); max-width: 44ch; margin: 0 auto 28px; }
  .home-chiusura .btn { color: var(--ivory); }

  @media (max-width: 860px) {
    .journal-grid { grid-template-columns: 1fr; gap: 44px; }
  }
</style>

<script>
  // blocco "metodo": la linea si disegna e i nodi si accendono quando entra in vista.
  const mp = document.getElementById('metodo-passi');
  if (mp) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) {
      mp.classList.add('drawn');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('drawn');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.35 }
      );
      io.observe(mp);
    }
  }
</script>
