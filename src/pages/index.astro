---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroRadiance from '../components/HeroRadiance.astro';
import WorldIndex from '../components/WorldIndex.astro';
import JournalCard from '../components/JournalCard.astro';
import Contact from '../components/Contact.astro';
import home from '../content/pagine/home.json';
import { accentDuo } from '../lib/text';

const journalPreview = home.journalPreview;
const metodo = (home as any).metodo;
---
<BaseLayout transparentNav={true}>
  <HeroRadiance />

  <!-- MANIFESTO -->
  <section class="manifesto reveal">
    <p class="eyebrow">{home.manifestoEyebrow}</p>
    <p class="statement" set:html={accentDuo(home.manifestoStatement)}></p>
    <p class="note">{home.manifestoNota}</p>
  </section>

  <!-- METODO / IL PERCORSO -->
  {metodo && (
    <section class="metodo reveal">
      <div class="metodo-head">
        {metodo.eyebrow && <p class="eyebrow eyebrow--gold">{metodo.eyebrow}</p>}
        <h2>{metodo.titolo}</h2>
        {metodo.testo && metodo.testo.split('\n').filter(Boolean).map((par: string) => <p class="mtxt">{par}</p>)}
      </div>
      <ol class="metodo-passi">
        {(metodo.passi ?? []).map((s: any) => (
          <li>
            <span class="mnum">{s.numero}</span>
            <div>
              <h3>{s.titolo}</h3>
              <p>{s.testo}</p>
            </div>
          </li>
        ))}
      </ol>
      {metodo.linkLabel && (
        <p class="metodo-link">
          {metodo.linkTesto} <a href={metodo.linkHref || '/percorso'}>{metodo.linkLabel}</a>
        </p>
      )}
    </section>
  )}

  <!-- INDICE DEI MONDI -->
  <WorldIndex />

  <!-- PROGETTO IN EVIDENZA (banda cinematografica scura) -->
  <section
    class:list={['featured reveal', (home as any).featuredImmagine && 'has-photo']}
    style={(home as any).featuredImmagine
      ? `background-image: linear-gradient(180deg, rgba(20,26,21,.35), rgba(20,26,21,.72)), url(${(home as any).featuredImmagine}); background-size: cover; background-position: center;`
      : undefined}
  >
    <div class="featured-inner">
      <p class="eyebrow">{home.featuredEyebrow}</p>
      <h3>{home.featuredTitolo.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h3>
      <p>{home.featuredTesto}</p>
      <a class="btn" href={home.featuredHref}>{home.featuredCta}</a>
    </div>
  </section>

  <!-- PREVIEW JOURNAL -->
  <section class="journal">
    <div class="journal-head">
      <h2>{home.journalHeading}</h2>
      <a class="btn btn--dark" href="/journal">{home.journalCta}</a>
    </div>
    <div class="journal-grid">
      {journalPreview.map((j) => (
        <JournalCard
          stamp={j.stamp}
          title={j.title}
          place={j.place}
          frame={j.frame}
          image={(j as any).immagine}
          tone={j.tono as 'warm' | 'green' | 'amber' | 'stone'}
          href={j.href}
        />
      ))}
    </div>
  </section>

  <!-- CONTATTI + FIRMA -->
  <Contact />
</BaseLayout>

<style>
  /* ---------- MANIFESTO ---------- */
  .manifesto { padding: clamp(90px, 15vh, 190px) var(--pad); max-width: 1200px; }
  .manifesto .eyebrow { margin-bottom: 34px; }
  .manifesto .statement {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(24px, 3.4vw, 46px);
    line-height: 1.28;
    letter-spacing: -.01em;
    max-width: 20ch;
  }
  .manifesto .hl { font-style: italic; color: var(--green); }
  .manifesto .amberhl { color: var(--amber); font-style: italic; }
  .manifesto .note {
    font-family: var(--sans);
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 52ch;
    margin-top: 38px;
    line-height: 1.7;
  }

  /* ---------- METODO ---------- */
  .metodo {
    padding: clamp(20px, 4vh, 40px) var(--pad) clamp(70px, 12vh, 130px);
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid var(--line);
  }
  .metodo-head { max-width: 720px; padding-top: clamp(40px, 7vh, 70px); }
  .metodo-head h2 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(26px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -.02em;
    margin: .18em 0 .5em;
  }
  .metodo-head .mtxt { color: var(--ink-soft); line-height: 1.7; margin-bottom: 1em; max-width: 60ch; }
  .metodo-passi {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 44px);
    margin: clamp(40px, 6vh, 60px) 0 clamp(30px, 4vh, 40px);
  }
  .metodo-passi li { border-top: 1px solid var(--line); padding-top: 18px; }
  .metodo-passi .mnum { font-family: var(--serif); font-style: italic; font-size: 15px; color: var(--amber); }
  .metodo-passi h3 { font-family: var(--serif); font-weight: 400; font-size: clamp(17px, 1.7vw, 21px); margin: 6px 0 8px; }
  .metodo-passi p { color: var(--ink-soft); font-size: 14px; line-height: 1.55; }
  .metodo-link { color: var(--ink-soft); font-size: 15px; max-width: 60ch; }
  .metodo-link a { color: var(--amber); border-bottom: 1px solid var(--amber); padding-bottom: 1px; white-space: nowrap; }

  @media (max-width: 860px) {
    .metodo-passi { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .metodo-passi { grid-template-columns: 1fr; }
  }

  /* ---------- FEATURED ---------- */
  .featured {
    position: relative;
    margin: clamp(30px, 6vh, 80px) 0;
    min-height: 82vh;
    display: flex;
    align-items: flex-end;
    color: var(--ivory);
    overflow: hidden;
    background:
      radial-gradient(80% 120% at 20% 0%, rgba(244, 217, 160, .28), rgba(244, 217, 160, 0) 55%),
      linear-gradient(180deg, #3a4a3c 0%, #29352b 60%, #1d2620 100%);
  }
  .featured.has-photo::before { content: none; }
  .featured::before {
    content: "[ fotografia a tutto schermo: progetto in evidenza ]";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: rgba(245, 239, 226, .4);
  }
  .featured-inner { position: relative; z-index: 2; padding: var(--pad); max-width: 820px; }
  .featured .eyebrow { color: var(--glow); }
  .featured h3 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(34px, 6vw, 86px);
    line-height: 1;
    letter-spacing: -.02em;
    margin: .2em 0;
  }
  .featured p { max-width: 44ch; color: rgba(245, 239, 226, .8); }
  .featured .btn { margin-top: 26px; }

  /* ---------- JOURNAL ---------- */
  .journal { padding: clamp(80px, 13vh, 150px) var(--pad); }
  .journal-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 44px;
  }
  .journal-head h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(28px, 4vw, 52px);
    letter-spacing: -.01em;
    max-width: 16ch;
  }
  .journal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px); }

  @media (max-width: 860px) {
    .journal-grid { grid-template-columns: 1fr; gap: 44px; }
  }
</style>
