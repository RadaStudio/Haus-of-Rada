---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const progetti = await getCollection('progetti');
  return progetti.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const p = entry.data;
const CAT_LABEL = { residenziale: 'Residenziale', horeca: 'Horeca' };
const heroClass = p.categoria === 'horeca' ? 'h-hor' : 'h-res';
---
<BaseLayout title={`${p.titolo} — Haus of Rada`} description={p.linea} activeNav="Interni">
  <article class="detail">
    <header
      class:list={['d-hero', heroClass, p.cover && 'has-photo']}
      style={p.cover
        ? `background-image: linear-gradient(180deg, rgba(20,20,16,.3), rgba(20,20,16,.72)), url(${p.cover}); background-size: cover; background-position: center;`
        : undefined}
    >
      <div class="d-hero-inner">
        <p class="eyebrow">{CAT_LABEL[p.categoria]} · {p.tipo}</p>
        <h1>{p.titolo}</h1>
        <div class="facts">
          <div><b>Luogo</b>{p.luogo}</div>
          <div><b>Anno</b>{p.anno}</div>
          <div><b>Superficie</b>{p.mq}</div>
          <div><b>Tipo</b>{p.tipo}</div>
          {p.ruolo && <div><b>Ruolo</b>{p.ruolo}</div>}
        </div>
      </div>
    </header>

    <div class="backbar">
      <a class="backbtn" href="/progetti"><span aria-hidden="true">←</span> Tutti i progetti</a>
    </div>

    <div class="d-body">
      <div class="d-intro reveal">
        <div><p class="eyebrow">Il progetto</p><h2>{p.linea}</h2></div>
        <div>{p.concept.map((c) => <p>{c}</p>)}</div>
      </div>

      {p.problema && (
        <div class="d-problema reveal">
          <p class="eyebrow">Il problema</p>
          <p>{p.problema}</p>
        </div>
      )}

      <h2 class="d-section-title">La natura del progetto</h2>
      <div class="natura">
        {p.natura.map((n) => (
          <div class="n reveal">
            <div class="k">{n.k}</div>
            <p>{n.t}</p>
          </div>
        ))}
      </div>

      <h2 class="d-section-title">Immagini &amp; planimetrie</h2>
      <Gallery tono={p.tono} />

      <div class="d-cta reveal">
        <h3>Hai uno spazio con un <i>problema simile?</i></h3>
        <a class="btn" href="/contatti">Scrivimi, ne parliamo →</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* ---------- HERO immersivo ---------- */
  .d-hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    color: var(--ivory);
    overflow: hidden;
  }
  .d-hero.has-photo::before { content: none; }
  .d-hero::before {
    content: "[ fotografia a tutto schermo del progetto ]";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: rgba(245, 239, 226, .4);
  }
  .d-hero.h-res {
    background: radial-gradient(80% 120% at 22% 0%, rgba(244, 217, 160, .25), transparent 55%),
      linear-gradient(180deg, #4a4436, #2c2820 70%, #1e1b15);
  }
  .d-hero.h-hor {
    background: radial-gradient(80% 120% at 22% 0%, rgba(244, 217, 160, .28), transparent 55%),
      linear-gradient(180deg, #3a4a3c, #29352b 60%, #1d2620);
  }
  .d-hero-inner { position: relative; z-index: 2; padding: var(--pad); max-width: 900px; }
  .d-hero .eyebrow { color: var(--glow); }
  .d-hero h1 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(38px, 7vw, 96px);
    line-height: .98;
    letter-spacing: -.02em;
    margin: .18em 0 .3em;
  }
  .d-hero .facts { display: flex; gap: 28px; flex-wrap: wrap; color: rgba(245, 239, 226, .82); font-size: 13.5px; letter-spacing: .04em; }
  .d-hero .facts b {
    display: block;
    font-weight: 400;
    color: rgba(245, 239, 226, .55);
    font-size: 10.5px;
    letter-spacing: .18em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  /* ---------- back bar sticky ---------- */
  .backbar {
    position: sticky;
    top: var(--nav-h);
    z-index: 15;
    background: rgba(245, 239, 226, .9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    padding: 12px var(--pad);
  }
  .backbtn {
    background: none;
    border: none;
    color: var(--ink);
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    display: inline-flex;
    gap: 10px;
    align-items: center;
  }
  .backbtn span { transition: transform .3s var(--ease); }
  .backbtn:hover span { transform: translateX(-5px); }

  /* ---------- body ---------- */
  .d-body { max-width: 1200px; margin: 0 auto; padding: clamp(60px, 10vh, 120px) var(--pad); }
  .d-intro {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: clamp(30px, 6vw, 90px);
    align-items: start;
    padding-bottom: clamp(50px, 8vh, 90px);
    border-bottom: 1px solid var(--line);
  }
  .d-intro .eyebrow { color: var(--amber); }
  .d-intro h2 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(24px, 3.2vw, 40px);
    line-height: 1.25;
    letter-spacing: -.01em;
    margin-top: 12px;
  }
  .d-intro p { color: var(--ink-soft); margin-bottom: 16px; }

  .d-problema { padding-top: clamp(34px, 5vh, 56px); max-width: 820px; }
  .d-problema .eyebrow { color: var(--amber); margin-bottom: 14px; }
  .d-problema p {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(19px, 2.3vw, 27px);
    line-height: 1.4;
    letter-spacing: -.01em;
    color: var(--ink);
  }

  .d-section-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 32px);
    margin: clamp(50px, 8vh, 90px) 0 30px;
    letter-spacing: -.01em;
  }
  .natura { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 44px); }
  .natura .n { border-top: 1px solid var(--line); padding-top: 20px; }
  .natura .n .k { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--amber); margin-bottom: 12px; }
  .natura .n p { color: var(--ink-soft); font-size: 15px; }

  .d-cta {
    background: var(--green-deep);
    color: var(--ivory);
    border-radius: 2px;
    padding: clamp(40px, 6vw, 70px);
    margin-top: clamp(60px, 10vh, 110px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }
  .d-cta h3 { font-family: var(--serif); font-weight: 300; font-size: clamp(24px, 3vw, 38px); max-width: 16ch; line-height: 1.1; }
  .d-cta h3 i { font-style: italic; color: var(--glow); }
  .d-cta .btn { color: var(--ivory); }

  @media (max-width: 860px) {
    .d-intro { grid-template-columns: 1fr; gap: 24px; }
    .natura { grid-template-columns: 1fr; }
  }
</style>
