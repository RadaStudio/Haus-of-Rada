---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CollectionFilter from '../../components/CollectionFilter.jsx';
import { getCollection } from 'astro:content';
import interni from '../../content/pagine/interni.json';

const FILTERS = [
  { key: 'tutti', label: 'Tutti' },
  { key: 'residenziale', label: 'Residenziale' },
  { key: 'horeca', label: 'Horeca' },
];

const progetti = (await getCollection('progetti')).sort(
  (a, b) => a.data.ordine - b.data.ordine
);
---
<BaseLayout
  title="Progetti — Interni · Haus of Rada"
  description="Progettazione d'interni residenziale e horeca: case, appartamenti e luoghi dell'ospitalità. La luce prima di tutto, materiali veri, un dettaglio sartoriale in ogni ambiente."
  activeNav="Portfolio"
>
  <div class="page">
    <div class="page-head">
      <p class="eyebrow">{interni.eyebrow}</p>
      <h1>{interni.titolo}</h1>
      {interni.intro.split('\n').filter(Boolean).map((par) => <p>{par}</p>)}
    </div>

    <CollectionFilter
      client:load
      gridId="progetti-grid"
      attr="cat"
      filters={FILTERS}
      total={progetti.length}
      nounOne="progetto"
      nounMany="progetti"
      label="Filtra i progetti per categoria"
    />

    {(interni as any).notaFiltro && <p class="filtro-nota">{(interni as any).notaFiltro}</p>}

    <div class="grid" id="progetti-grid">
      {progetti.map((p) => (
        <ProjectCard
          slug={p.id}
          titolo={p.data.titolo}
          categoria={p.data.categoria}
          luogo={p.data.luogo}
          anno={p.data.anno}
          linea={p.data.linea}
          cover={p.data.cover}
          ruolo={p.data.ruolo}
          tono={p.data.tono}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { padding: calc(var(--nav-h) + 5vh) var(--pad) 0; }
  .page-head { max-width: 1300px; margin: 0 auto clamp(30px, 5vh, 54px); }
  .page-head p + p { margin-top: 14px; }
  .filtro-nota { max-width: 1300px; margin: 16px auto 0; font-size: 13px; color: var(--ink-soft); font-style: italic; }
  .page-head .eyebrow { color: var(--amber); }
  .page-head h1 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(44px, 9vw, 120px);
    line-height: .94;
    letter-spacing: -.02em;
    margin: .16em 0 .3em;
  }
  .page-head p { max-width: 52ch; color: var(--ink-soft); }

  .grid {
    max-width: 1300px;
    margin: clamp(30px, 5vh, 52px) auto clamp(80px, 12vh, 140px);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(24px, 3.4vw, 56px);
  }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
