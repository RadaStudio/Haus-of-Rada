---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialStamp from '../../components/EditorialStamp.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const storie = await getCollection('journal', ({ data }) => !data.bozza);
  return storie.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const post = entry.data;
const { Content } = await render(entry);

const SERIE = {
  guide: { stamp: 'Guide', frame: 'guida' },
  anatomia: { stamp: 'Anatomia', frame: 'luogo' },
  oggetti: { stamp: 'Oggetti', frame: 'oggetto' },
  lifestyle: { stamp: 'Lifestyle', frame: 'lifestyle' },
};
const m = SERIE[post.serie];
const dateStr = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }).format(post.data);

const indirizzi = post.indirizzi ?? [];
const TIPO_LABEL = { hotel: 'Hotel', oggetto: 'Oggetto', luogo: 'Luogo', esperienza: 'Esperienza', store: 'Store' };
---
<BaseLayout title={`${post.titolo} — Haus of Rada`} description={post.estratto ?? post.titolo} activeNav="Journal">
  <div class="backbar">
    <a class="backbtn" href="/journal"><span aria-hidden="true">←</span> Journal</a>
  </div>

  <article class="article">
    <header class="art-head reveal">
      <EditorialStamp label={m.stamp} />
      <h1>{post.titolo}</h1>
      <p class="meta">{post.luogo} &nbsp;·&nbsp; {dateStr}</p>
      {post.estratto && <p class="lead">{post.estratto}</p>}
    </header>

    <Placeholder label={m.frame} src={post.cover} alt={post.titolo} tone={post.tono} ratio="3/2" class="art-cover" />

    <div class="article-body reveal">
      <Content />
    </div>

    {indirizzi.length > 0 && (
      <section class="indirizzi reveal" aria-label="Indirizzi e link del racconto">
        <h2 class="d-section-title">Gli indirizzi del racconto</h2>
        <ul class="indirizzi-list">
          {indirizzi.map((i) => (
            <li>
              <a href={i.url} target="_blank" rel="sponsored nofollow noopener noreferrer" class="ext-link" data-affiliate="true">
                {i.tipo && <span class="tipo">{TIPO_LABEL[i.tipo]}</span>}
                <span class="label">{i.label}</span>
                {i.nota && <span class="nota">{i.nota}</span>}
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="affiliate-disclosure">
          Trasparenza: alcuni link qui sopra sono affiliati. Se prenoti o acquisti,
          Haus of Rada può ricevere una piccola commissione — senza alcun costo aggiuntivo per te.
        </p>
      </section>
    )}

    <footer class="art-foot">
      <p class="eyebrow">Fine</p>
      <a class="btn btn--dark" href="/journal">Torna al Journal →</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .backbar {
    position: sticky;
    top: var(--nav-h);
    z-index: 15;
    background: rgba(245, 239, 226, .9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    padding: 12px var(--pad);
  }
  .backbtn {
    color: var(--ink);
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    display: inline-flex;
    gap: 10px;
    align-items: center;
  }
  .backbtn span { transition: transform .3s var(--ease); }
  .backbtn:hover span { transform: translateX(-5px); }

  .article { max-width: 820px; margin: 0 auto; padding: clamp(50px, 9vh, 110px) var(--pad) 0; }
  .art-head { text-align: center; margin-bottom: clamp(30px, 5vh, 50px); }
  .art-head :global(.stamp) { display: block; margin-bottom: 20px; }
  .art-head h1 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(30px, 5.4vw, 62px);
    line-height: 1.05;
    letter-spacing: -.02em;
    max-width: 20ch;
    margin: 0 auto;
  }
  .art-head .meta {
    margin-top: 20px;
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .art-head .lead {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.4;
    color: var(--green);
    max-width: 42ch;
    margin: 26px auto 0;
  }

  .article :global(.art-cover) { margin: 0 auto; }

  /* prosa leggibile */
  .article-body {
    max-width: 40rem;
    margin: clamp(40px, 7vh, 80px) auto 0;
    font-size: clamp(16px, 1.15vw, 18px);
    line-height: 1.75;
  }
  .article-body :global(p) { margin-bottom: 1.3em; color: var(--ink); }
  .article-body :global(h2) {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 30px);
    letter-spacing: -.01em;
    margin: 1.8em 0 .6em;
  }
  .article-body :global(a) { color: var(--amber); text-decoration: underline; text-underline-offset: 3px; }
  /* link esterni (affiliati) nel corpo: piccolo indicatore */
  .article-body :global(a.ext-link)::after { content: " ↗"; font-size: .85em; }
  .article-body :global(em) { font-style: italic; }
  .article-body :global(blockquote) {
    border-left: 2px solid var(--gold);
    padding-left: 20px;
    margin: 1.4em 0;
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-soft);
  }

  /* ---------- indirizzi & link affiliati ---------- */
  .indirizzi { max-width: 40rem; margin: clamp(40px, 7vh, 80px) auto 0; }
  .indirizzi .d-section-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 30px);
    letter-spacing: -.01em;
    margin: 0 0 20px;
  }
  .indirizzi-list { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .indirizzi-list li { border-top: 1px solid var(--line); }
  .indirizzi-list li:last-child { border-bottom: 1px solid var(--line); }
  .indirizzi-list a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: 16px;
    row-gap: 2px;
    padding: 18px 4px;
    transition: padding-left .35s var(--ease);
  }
  .indirizzi-list a:hover { padding-left: 12px; }
  .indirizzi-list .tipo {
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--amber);
    grid-column: 1;
  }
  .indirizzi-list .label {
    font-family: var(--serif);
    font-size: clamp(17px, 2vw, 21px);
    color: var(--ink);
    grid-column: 2;
  }
  .indirizzi-list .nota {
    grid-column: 2;
    font-size: 13px;
    color: var(--ink-soft);
  }
  .indirizzi-list .arrow { grid-column: 3; grid-row: 1 / span 2; color: var(--green); font-size: 18px; align-self: center; transition: transform .35s var(--ease); }
  .indirizzi-list a:hover .arrow { transform: translate(3px, -3px); }
  .affiliate-disclosure {
    margin-top: 20px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--ink-soft);
    font-style: italic;
  }

  .art-foot {
    max-width: 40rem;
    margin: clamp(50px, 9vh, 100px) auto clamp(70px, 12vh, 130px);
    padding-top: 30px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
</style>
