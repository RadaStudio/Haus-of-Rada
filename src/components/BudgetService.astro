---
// Sezione servizio "Progetta con un budget": consulenza all'acquisto / buyer.
// Comunica che, oltre alla progettazione, guidiamo il cliente all'acquisto
// dei complementi d'arredo in linea con il budget, ottimizzando la spesa.
import studio from '../content/pagine/studio.json';
import { accent } from '../lib/text';
const punti = studio.budgetPunti;
---
<section class="budget" id="budget">
  <div class="budget-head reveal">
    <p class="eyebrow eyebrow--gold">{studio.budgetEyebrow}</p>
    <h2 set:html={accent(studio.budgetTitolo)}></h2>
    <p class="lead" set:html={accent(studio.budgetLead)}></p>
  </div>

  <div class="budget-grid">
    {punti.map((p) => (
      <div class="b reveal">
        <div class="k">{p.k}</div>
        <p>{p.t}</p>
      </div>
    ))}
  </div>

  <a class="btn btn--dark" href="/contatti">{studio.budgetCta}</a>
</section>

<style>
  .budget {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(60px, 10vh, 120px) var(--pad);
    border-top: 1px solid var(--line);
  }
  .budget-head { max-width: 760px; margin-bottom: clamp(36px, 6vh, 64px); }
  .budget-head h2 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(30px, 5vw, 62px);
    line-height: 1.02;
    letter-spacing: -.02em;
    margin: .16em 0 .4em;
  }
  .budget-head h2 i { font-style: italic; color: var(--amber); }
  .budget-head .lead { font-size: clamp(16px, 1.4vw, 19px); color: var(--ink-soft); max-width: 60ch; }
  .budget-head .lead i { font-style: italic; color: var(--green); }

  .budget-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 44px);
    margin-bottom: clamp(36px, 6vh, 56px);
  }
  .budget-grid .b { border-top: 1px solid var(--line); padding-top: 20px; }
  .budget-grid .k {
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 12px;
  }
  .budget-grid p { color: var(--ink-soft); font-size: 15px; }

  .budget .btn { color: var(--ink); }

  @media (max-width: 860px) {
    .budget-grid { grid-template-columns: 1fr; }
  }
</style>
