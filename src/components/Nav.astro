---
// Nav globale. `transparent` = parte trasparente (Home hero) e prende sfondo allo scroll.
// `active` = etichetta della voce corrente, per lo stato attivo.
interface Props {
  transparent?: boolean;
  active?: string;
}
const { transparent = false, active } = Astro.props;

const links = [
  { label: 'Interni', href: '/progetti' },
  { label: 'Il percorso', href: '/percorso' },
  { label: 'Collezione', href: '/collezione' },
  { label: 'Journal', href: '/journal' },
  { label: 'Studio', href: '/studio' },
  { label: 'Contatti', href: '/contatti' },
];
---

<nav id="site-nav" class={transparent ? 'is-transparent' : 'is-solid'}>
  <a class="wordmark" href="/" aria-label="Haus of Rada — home"><b>Haus</b><i>of</i><b>Rada</b></a>

  <div class="nav-links" id="nav-links">
    {links.map((l) => (
      <a href={l.href} class={active === l.label ? 'active' : undefined}>{l.label}</a>
    ))}
  </div>

  <button class="nav-menu-btn" id="nav-menu-btn" aria-expanded="false" aria-controls="nav-links" aria-label="Apri il menu">Menu</button>
</nav>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px var(--pad);
    transition: background .5s var(--ease), padding .5s var(--ease), box-shadow .5s var(--ease);
  }
  /* pagine interne: sfondo sempre presente */
  nav.is-solid {
    background: rgba(245, 239, 226, .82);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 var(--line);
    padding-top: 16px;
    padding-bottom: 16px;
  }
  /* Home: trasparente in cima, sfondo dopo lo scroll (classe .scrolled da script) */
  nav.is-transparent.scrolled {
    background: rgba(245, 239, 226, .82);
    backdrop-filter: blur(10px);
    padding-top: 14px;
    padding-bottom: 14px;
    box-shadow: 0 1px 0 var(--line);
  }

  .nav-links { display: flex; gap: clamp(14px, 2vw, 32px); align-items: center; }
  .nav-links a {
    font-size: 12.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    position: relative;
    padding: 4px 0;
    color: var(--ink-soft);
    transition: color .3s var(--ease);
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0;
    height: 1px; width: 0;
    background: var(--amber);
    transition: width .35s var(--ease);
  }
  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a.active { color: var(--ink); }
  .nav-links a:hover::after,
  .nav-links a:focus-visible::after,
  .nav-links a.active::after { width: 100%; }

  .nav-menu-btn { display: none; }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
      position: absolute;
      top: 100%; left: 0; right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 14px var(--pad) 22px;
      background: rgba(245, 239, 226, .96);
      backdrop-filter: blur(10px);
      box-shadow: 0 1px 0 var(--line);
    }
    .nav-links.open { display: flex; }
    .nav-links a { font-size: 14px; padding: 10px 0; }
    .nav-menu-btn {
      display: block;
      background: none;
      border: 1px solid var(--line);
      border-radius: 100px;
      padding: 8px 16px;
      font-size: 12px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--ink);
    }
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  // sfondo allo scroll (solo modalità trasparente / Home)
  if (nav && nav.classList.contains('is-transparent')) {
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 60);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // menu mobile
  const btn = document.getElementById('nav-menu-btn');
  const links = document.getElementById('nav-links');
  btn?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
    btn.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
  });
</script>
