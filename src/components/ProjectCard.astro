---
// Card progetto per la griglia. Segnaposto fotografia + badge categoria.
// data-cat serve al filtro (ProjectFilter island).
interface Props {
  slug: string;
  titolo: string;
  categoria: 'residenziale' | 'horeca';
  luogo: string;
  anno: string;
  linea: string;
  tono?: 'warm' | 'green' | 'amber' | 'stone';
  cover?: string | null;
}
const { slug, titolo, categoria, luogo, anno, linea, tono = 'stone', cover } = Astro.props;
const CAT_LABEL = { residenziale: 'Residenziale', horeca: 'Horeca' };
const hasCover = typeof cover === 'string' && cover.trim();
---
<a class="card" href={`/progetti/${slug}`} data-cat={categoria} aria-label={`${titolo} — ${luogo}, ${anno}`}>
  <div class:list={['thumb', !hasCover && `frame--${tono}`]}>
    <span class="cat">{CAT_LABEL[categoria]}</span>
    {hasCover
      ? <img class="thumb-img" src={cover} alt={titolo} loading="lazy" />
      : <span class="ph">[ fotografia: {titolo} ]</span>}
  </div>
  <div class="meta">
    <h3>{titolo}</h3>
    <span class="place">{luogo} · {anno}</span>
  </div>
  <p class="line">{linea}</p>
  <span class="explore">Esplora il progetto <span aria-hidden="true">→</span></span>
</a>

<style>
  .card { display: block; }
  .thumb {
    aspect-ratio: 5 / 4;
    border: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform .6s var(--ease);
  }
  .thumb::before { content: ""; position: absolute; inset: 10px; border: 1px solid var(--line); pointer-events: none; z-index: 1; }
  .thumb-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card:hover .thumb { transform: scale(.985); }
  .thumb .ph {
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--ink-soft);
    position: relative;
    padding: 0 16px;
    text-align: center;
  }
  .thumb .cat {
    position: absolute;
    top: 16px; left: 16px;
    z-index: 2;
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    background: rgba(245, 239, 226, .9);
    padding: 6px 12px;
    border-radius: 100px;
    color: var(--green);
  }
  .meta { display: flex; justify-content: space-between; align-items: baseline; margin-top: 18px; gap: 16px; }
  .card h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.05;
    letter-spacing: -.01em;
  }
  .place { font-size: 12.5px; color: var(--ink-soft); letter-spacing: .04em; white-space: nowrap; }
  .line { margin-top: 8px; color: var(--ink-soft); font-size: 14.5px; max-width: 44ch; }
  .explore {
    margin-top: 14px;
    font-size: 11.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--amber);
    display: inline-flex;
    gap: 8px;
  }
  .explore span { transition: transform .4s var(--ease); }
  .card:hover .explore span { transform: translateX(6px); }
</style>
