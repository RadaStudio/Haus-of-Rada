---
// Segnaposto fotografia: cornice + etichetta [ fotografia: … ].
// Regge i layout finché mancano le foto reali (convenzione /img/...).
interface Props {
  label: string;
  tone?: 'warm' | 'green' | 'amber' | 'stone' | 'neutral';
  ratio?: string;      // es. "3/4", "5/4", "16/10"
  class?: string;
}
const { label, tone = 'neutral', ratio, class: className } = Astro.props;
const toneClass = tone === 'neutral' ? '' : `frame--${tone}`;
const style = ratio ? `aspect-ratio:${ratio}` : undefined;
---
<div class:list={['frame', toneClass, className]} style={style} aria-hidden="true">
  <span>[ fotografia: {label} ]</span>
</div>
