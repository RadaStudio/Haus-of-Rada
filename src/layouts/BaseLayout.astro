---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  transparentNav?: boolean;
  activeNav?: string;
  footer?: boolean;
}
const {
  title = 'Haus of Rada — Luce sulle cose belle',
  description = "Atelier editoriale di Marianna Radaelli: progettazione d'interni residenziale e horeca, collezione di oggetti e arte, e un journal di racconto del design.",
  transparentNav = false,
  activeNav,
  footer = true,
} = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- progressive enhancement: marca subito il documento come "js" (prima del paint)
         così le animazioni reveal si attivano solo quando il JS è disponibile -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F5EFE2" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="it_IT" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Instrument+Sans:ital,wght@0,400..600;1,400..500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Salta al contenuto</a>
    <Nav transparent={transparentNav} active={activeNav} />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 8px;
        z-index: 100;
        background: var(--ink);
        color: var(--ivory);
        padding: 10px 18px;
        border-radius: 100px;
        font-size: 12px;
        letter-spacing: .14em;
        text-transform: uppercase;
      }
      .skip-link:focus { left: var(--pad); }
    </style>

    <script>
      // scroll-reveal via IntersectionObserver (.reveal -> .in)
      // rispetta prefers-reduced-motion: mostra tutto senza animare
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.14 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
